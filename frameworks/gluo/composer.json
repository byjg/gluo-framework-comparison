{
  "version": "7.0",
  "name": "byjg/gluo-product-demo",
  "description": "A PHP REST API built with Gluo.",
  "type": "project",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "license": "MIT",
  "require": {
    "php": ">=8.3 <8.7",
    "ext-json": "*",
    "ext-openssl": "*",
    "ext-curl": "*",
    "byjg/gluo-core": "^7.0",
    "byjg/scriptify": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5",
    "psalm/phar": "^6.16"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "Builder\\": "builder/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "@php gluo test",
    "migrate": [
      "Composer\\Config::disableProcessTimeout",
      "@php gluo migrate"
    ],
    "codegen": "@php gluo codegen",
    "openapi": "@php gluo openapi",
    "openapi:check": "@php gluo openapi:check",
    "terminal": [
      "Composer\\Config::disableProcessTimeout",
      "@php gluo terminal"
    ],
    "psalm": "vendor/bin/psalm.phar",
    "compile": "git pull && php gluo openapi && php gluo test",
    "up-local-dev": "docker compose -f docker-compose.yml up -d",
    "down-local-dev": "docker compose -f docker-compose.yml down"
  }
}
